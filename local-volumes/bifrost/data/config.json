{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "client": {
    "enable_logging": true,
    "disable_content_logging": false,
    "log_retention_days": 14
  },
  "providers": {
    "fireworks": {
      "network_config": {
        "default_request_timeout_in_seconds": 300
      },
      "store_raw_request_response": true,
      "send_back_raw_response": true,
      "keys": [
        {
          "name": "Fireworks AI",
          "value": "env.FIREWORKS_API_KEY",
          "weight": 1.0,
          "models": ["*"],
          "aliases": {
            "deepseek-v4-flash": "accounts/fireworks/models/deepseek-v4-flash-0731",
            "deepseek-v4-pro": "accounts/fireworks/models/deepseek-v4-pro-0813",
            "glm-5.2": "accounts/fireworks/models/glm-5p2",
            "gpt-oss-120b": "accounts/fireworks/models/gpt-oss-120b",
            "inkling": "accounts/fireworks/models/inkling",
            "kimi-k2.7-code": "accounts/fireworks/models/kimi-k2p7-code",
            "kimi-k3": "accounts/fireworks/models/kimi-k3",
            "minimax-m3": "accounts/fireworks/models/minimax-m3",
            "muse-glimmer-30b": "accounts/fireworks/models/muse-glimmer-30b",
            "nemotron-3-ultra": "accounts/fireworks/models/nemotron-3-ultra-nvfp4",
            "nemotron-lightning-3.5": "accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b",
            "qwen-3.7-plus": "accounts/fireworks/models/qwen3p7-plus",
            "qwen-3.8-max": "accounts/fireworks/models/qwen3p8-max",
            "qwen-3-embedding-8b": "accounts/fireworks/models/qwen3-embedding-8b",
            "qwen-3-reranker-8b": "accounts/fireworks/models/qwen3-reranker-8b"
          }
        }
      ]
    },
    "openai": {
      "network_config": {
        "default_request_timeout_in_seconds": 300
      },
      "store_raw_request_response": true,
      "send_back_raw_response": true,
      "keys": [
        {
          "name": "OpenAI API",
          "value": "env.OPENAI_API_KEY",
          "weight": 1.0,
          "models": [
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gpt-5.4-mini",
            "gpt-5.4-nano",
            "gpt-image-2",
            "gpt-audio-1.5",
            "gpt-realtime-2.1",
            "gpt-realtime-2.1-mini",
            "gpt-realtime-whisper",
            "tts-1",
            "gpt-4o-mini-transcribe",
            "gpt-4o-mini-tts",
            "text-embedding-3-large",
            "text-embedding-3-small"
          ],
          "aliases": {
            "gpt-5.6-sol": "gpt-5.6-sol",
            "gpt-5.6-terra": "gpt-5.6-terra",
            "gpt-5.6-luna": "gpt-5.6-luna",
            "gpt-5.4-mini": "gpt-5.4-mini",
            "gpt-5.4-nano": "gpt-5.4-nano",
            "gpt-image-2": "gpt-image-2",
            "gpt-audio-1.5": "gpt-audio-1.5",
            "gpt-realtime-2.1": "gpt-realtime-2.1",
            "gpt-realtime-2.1-mini": "gpt-realtime-2.1-mini",
            "gpt-realtime-whisper": "gpt-realtime-whisper",
            "tts-1": "tts-1",
            "gpt-4o-mini-transcribe": "gpt-4o-mini-transcribe",
            "gpt-4o-mini-tts": "gpt-4o-mini-tts",
            "text-embedding-3-large": "text-embedding-3-large",
            "text-embedding-3-small": "text-embedding-3-small"
          }
        }
      ]
    },
    "azure": {
      "store_raw_request_response": true,
      "send_back_raw_response": true,
      "keys": [
        {
          "id": "azure-foundry",
          "name": "Azure Foundry",
          "value": "env.AZURE_OPENAI_API_KEY",
          "weight": 1.0,
          "azure_key_config": {
            "endpoint": "env.AZURE_ENDPOINT",
            "api_version": "2024-10-21"
          },
          "models": [
            "az-5.4-nano",
            "az-5.4-mini",
            "az-chat-latest",
            "az-5.6-luna",
            "az-5.6-terra",
            "az-5.6-sol",
            "az-claude-haiku-4.5",
            "az-claude-opus-5",
            "az-claude-sonnet-5",
            "az-oss-120b",
            "az-text-embedding-3-large",
            "az-text-embedding-3-small",
            "az-gpt-4o-mini-transcribe",
            "az-gpt-4o-mini-tts",
            "az-gpt-audio-1.5",
            "az-gpt-oss-120b",
            "az-gpt-realtime-2.1",
            "az-gpt-realtime-2.1-mini",
            "az-gpt-image-1-mini",
            "az-gpt-image-1.5",
            "az-gpt-image-2",
            "az-sora-2",
            "az-grok-4.3",
            "az-deepseek-v4-flash",
            "az-deepseek-v4-pro",
            "az-kimi-k2.7-code"
          ],
          "aliases": {
            "az-5.4-mini": "gpt-5.4-mini",
            "az-5.4-nano": "gpt-5.4-nano",
            "az-chat-latest": "gpt-chat-latest",
            "az-5.6-luna": "gpt-5.6-luna",
            "az-5.6-terra": "gpt-5.6-terra",
            "az-5.6-sol": "gpt-5.6-sol",
            "az-claude-haiku-4.5": "claude-haiku-4-5",
            "az-claude-opus-5": "claude-opus-5",
            "az-claude-sonnet-5": "claude-sonnet-5",
            "az-oss-120b": "gpt-oss-120b",
            "az-text-embedding-3-small": "text-embedding-3-small",
            "az-text-embedding-3-large": "text-embedding-3-large",
            "az-gpt-4o-mini-transcribe": "gpt-4o-mini-transcribe",
            "az-gpt-4o-mini-tts": "gpt-4o-mini-tts",
            "az-gpt-audio-1.5": "gpt-audio-1.5-1",
            "az-gpt-oss-120b": "gpt-oss-120b",
            "az-gpt-realtime-2.1": "gpt-realtime-2.1",
            "az-gpt-realtime-2.1-mini": "gpt-realtime-2.1-mini",
            "az-gpt-image-1-mini": "gpt-image-1-mini",
            "az-gpt-image-1.5": "gpt-image-1.5",
            "az-gpt-image-2": "gpt-image-2-1",
            "az-sora-2": "sora-2",
            "az-grok-4.3": "grok-4.3",
            "az-deepseek-v4-flash": "DeepSeek-V4-Flash-0731",
            "az-deepseek-v4-pro": "DeepSeek-V4-Pro",
            "az-kimi-k2.7-code": "Kimi-K2.7-Code"
          }
        }
      ],
      "network_config": {
        "base_url": "env.AZURE_ENDPOINT",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 5,
        "retry_backoff_initial": 100,
        "retry_backoff_max": 10000
      }
    },
    "ollama": {
      "store_raw_request_response": true,
      "send_back_raw_response": true,
      "keys": [
        {
          "id": "ollama",
          "name": "oMLX",
          "value": "env.OLLAMA_API_KEY",
          "weight": 1.0,
          "ollama_key_config": {
            "url": "env.OLLAMA_BASE_URL"
          },
          "models": ["*"]
        }
      ],
      "network_config": {
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 1200,
        "max_retries": 5,
        "retry_backoff_initial": 100,
        "retry_backoff_max": 10000
      }
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "qdrant",
    "config": {
      "host": "bifrost-qdrant",
      "port": 6334
    }
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.BIFROST_POSTGRES_HOST",
      "port": "env.BIFROST_POSTGRES_PORT",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DB",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.BIFROST_POSTGRES_HOST",
      "port": "env.BIFROST_POSTGRES_PORT",
      "user": "env.BIFROST_POSTGRES_USER",
      "password": "env.BIFROST_POSTGRES_PASSWORD",
      "db_name": "env.BIFROST_POSTGRES_DB",
      "ssl_mode": "disable"
    },
    "retention_days": 14
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "b2ee5310-69d2-41e8-84f7-95f2f69a3716",
        "name": "self-hosted-app-stack",
        "value": "env.BIFROST_API_KEY",
        "is_active": true,
        "mcp_configs": [
          { "mcp_client_name": "Atlassian", "tools_to_execute": ["*"] },
          { "mcp_client_name": "TDX", "tools_to_execute": ["*"] },
          { "mcp_client_name": "Context7", "tools_to_execute": ["*"] },
          { "mcp_client_name": "Mermaid", "tools_to_execute": ["*"] },
          { "mcp_client_name": "Crawl4AI", "tools_to_execute": ["*"] },
          { "mcp_client_name": "Obscura", "tools_to_execute": ["*"] }
        ],
        "provider_configs": [
          {
            "provider": "azure",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "fireworks",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "openai",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      }
    ]
  },
  "mcp": {
    "client_configs": [
      {
        "name": "Atlassian",
        "client_id": "atlassian",
        "connection_type": "http",
        "connection_string": "env.ATLASSIAN_MCP_SERVER_URL",
        "auth_type": "none",
        "is_code_mode_client": true,
        "is_ping_available": false,
        "tools_to_execute": ["*"],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "TDX",
        "client_id": "tdx",
        "connection_type": "http",
        "connection_string": "env.TDX_MCP_SERVER_URL",
        "auth_type": "none",
        "is_code_mode_client": true,
        "is_ping_available": false,
        "tools_to_execute": ["*"],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "Context7",
        "client_id": "context7",
        "connection_type": "http",
        "connection_string": "env.CONTEXT7_MCP_SERVER_URL",
        "auth_type": "headers",
        "headers": {
          "CONTEXT7_API_KEY": "env.CONTEXT7_API_KEY"
        },
        "is_code_mode_client": true,
        "is_ping_available": true,
        "tools_to_execute": ["*"],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "Mermaid",
        "client_id": "mermaid",
        "connection_type": "http",
        "connection_string": "env.MERMAID_MCP_SERVER_URL",
        "auth_type": "none",
        "is_code_mode_client": true,
        "is_ping_available": true,
        "tools_to_execute": ["*"],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "Obscura",
        "client_id": "obscura",
        "connection_type": "http",
        "connection_string": "env.OBSCURA_MCP_SERVER_URL",
        "auth_type": "none",
        "is_code_mode_client": true,
        "is_ping_available": true,
        "tools_to_execute": ["*"],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "Crawl4AI",
        "client_id": "crawl4ai",
        "connection_type": "sse",
        "connection_string": "env.CRAWL4AI_MCP_SERVER_URL",
        "auth_type": "headers",
        "headers": {
          "Authorization": "env.CRAWL4AI_AUTH_HEADER"
        },
        "is_code_mode_client": true,
        "is_ping_available": true,
        "tools_to_execute": ["*"],
        "allow_on_all_virtual_keys": true
      }
    ]
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "collector_url": "phoenix:4317",
        "trace_type": "genai_extension",
        "protocol": "grpc",
        "enabled": true,
        "service_name": "bifrost",
        "group_traces_by_session": true,
        "insecure": true
      }
    },
    {
      "enabled": true,
      "name": "semantic_cache",
      "config": {
        "provider": "azure",
        "embedding_model": "az-text-embedding-3-small",
        "dimension": 1536,
        "ttl": "1h",
        "threshold": 0.8,
        "conversation_history_threshold": 6,
        "exclude_system_prompt": true,
        "cache_by_model": true,
        "cache_by_provider": true,
        "vector_store_namespace": "BifrostSemanticCachePlugin",
        "default_cache_key": "SelfHostedAppStack"
      }
    }
  ]
}
