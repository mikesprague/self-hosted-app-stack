{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": ["local-volumes/**"]
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "mdnsDomain": "self-hosted-app-stack.local",
    "cors": []
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow"
    }
  }
}
